# ---------------------------------------------------------------------------
# Per-host environment for the Graylog HA cluster (see cluster/README.md).
# Copy this to `cluster/.env` ON EACH MACHINE and fill in the values.
#
# Two of these (OS_NODE_NAME, OS_PUBLISH_HOST) DIFFER per machine.
# Everything else is IDENTICAL on every machine.
# ---------------------------------------------------------------------------

# --- This host's identity (DIFFERENT on each machine) ----------------------
# OpenSearch node name. Use exactly:
#   os-mac   on the MacBook (data node)
#   os-gb    on the Galaxy Book 3 (data node)
#   os-vote  on the Surface Pro 11 (voting-only tiebreaker)
OS_NODE_NAME=os-mac

# This host's OWN Tailscale address (100.x.y.z or its MagicDNS name).
# Peers connect to the node at this address, so it must be the Tailnet one,
# never 127.0.0.1 or a container name.
OS_PUBLISH_HOST=100.100.100.101

# --- Cluster-wide (IDENTICAL on every machine) -----------------------------
# Tailscale addresses of all three hosts:
MAC_TS=100.100.100.101
GB_TS=100.100.100.102
SP_TS=100.100.100.103

# Graylog secrets — MUST be byte-for-byte identical on BOTH data nodes
# (Mac + Galaxy Book). The Surface Pro ignores these.
#   GRAYLOG_PASSWORD_SECRET:    openssl rand -hex 48
#   GRAYLOG_ROOT_PASSWORD_SHA2: echo -n 'YourAdminPassword' | shasum -a 256
GRAYLOG_PASSWORD_SECRET=replace-with-openssl-rand-hex-48
GRAYLOG_ROOT_PASSWORD_SHA2=replace-with-sha256-of-admin-password

# ngrok authtoken — data nodes only (Mac + Galaxy Book). Endpoint Pooling
# requires a Pay-As-You-Go (or higher) ngrok plan. The Surface Pro runs no
# ngrok agent, so this can stay blank there.
NGROK_AUTHTOKEN=
