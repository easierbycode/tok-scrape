{
  "manifest_version": 3,
  "name": "Lifepreneur — Sample Value (demo)",
  "version": "0.1.0",
  "description": "Demo: open the orders.html fixture locally or on easierbycode.com, auto-open each order's detail template, mark 9/10 as $0 free samples, look up their TikTok Shop retail value, and tally the total in a Lifepreneur 'Sample Value' overlay.",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "activeTab", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://easierbycode.com/*",
    "https://shop.tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://thirsty-store-kiosk.easierbycode.deno.net/*",
    "https://tok-graylog-gelf.ngrok-free.dev/*"
  ],
  "icons": {
    "16":  "icons/16.png",
    "32":  "icons/32.png",
    "48":  "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Lifepreneur: value my free samples",
    "default_icon": {
      "16":  "icons/16.png",
      "32":  "icons/32.png",
      "48":  "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
