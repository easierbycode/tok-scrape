{
  "name": "graylog-shim",
  "version": "0.1.0",
  "tasks": {
    "dev": "KV_PATH=./local.kv API_TOKENS=devtoken ADMIN_PASSWORD=ChangeMeAdmin! deno run -A --unstable-kv --watch main.ts",
    "check": "deno check --unstable-kv main.ts lucene.ts import-to-kv.ts",
    "import:local": "KV_PATH=./local.kv deno run -A --unstable-kv import-to-kv.ts",
    "deploy": "deployctl deploy --prod --project graylog-shim main.ts"
  },
  "fmt": { "lineWidth": 110 },
  "lock": false
}
